{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adapted-research-arch.local/schemas/agent-manifest.v1.json",
  "title": "Adapted Research Agent Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "description",
    "maturity",
    "capabilities",
    "inputs",
    "outputs",
    "adapter",
    "risk",
    "permissions",
    "routing"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*)+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "description": {"type": "string", "minLength": 1, "maxLength": 500},
    "maturity": {"enum": ["experimental", "candidate", "stable", "deprecated"]},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_-]*$"}
    },
    "scenarioTags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "inputs": {"$ref": "#/$defs/schemaList"},
    "outputs": {"$ref": "#/$defs/schemaList"},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["command", "model", "remote_tool"]},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "provider": {"type": "string"},
        "model": {"type": "string"},
        "server": {"type": "string"},
        "tool": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "command"}}}, "then": {"required": ["command"]}},
        {"if": {"properties": {"type": {"const": "model"}}}, "then": {"required": ["provider"]}},
        {"if": {"properties": {"type": {"const": "remote_tool"}}}, "then": {"required": ["server", "tool"]}}
      ]
    },
    "risk": {"enum": ["R0", "R1", "R2", "R3", "R4", "R5"]},
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filesystem", "network", "process", "externalWrite"],
      "properties": {
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read", "write"],
          "properties": {
            "read": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "write": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {"enum": ["disabled", "retrieval", "allowlist"]},
            "hosts": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
          }
        },
        "process": {"type": "boolean"},
        "scheduler": {"type": "boolean", "default": false},
        "gpu": {"type": "boolean", "default": false},
        "externalWrite": {"type": "boolean"},
        "secretHandles": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "tools": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "evaluators": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxWallSeconds": {"type": "integer", "minimum": 1},
        "maxToolCalls": {"type": "integer", "minimum": 0},
        "maxSources": {"type": "integer", "minimum": 0},
        "maxCostUsd": {"type": "number", "minimum": 0}
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowImplicit"],
      "properties": {"allowImplicit": {"type": "boolean"}}
    }
  },
  "$defs": {
    "schemaList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*\\.v[0-9]+$"}
    }
  }
}
