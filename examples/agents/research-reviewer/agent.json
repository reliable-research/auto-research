{
  "schemaVersion": "1.0",
  "id": "research.reviewer",
  "version": "0.1.0",
  "name": "research-reviewer",
  "description": "Frames objectives and measurable completion criteria.",
  "maturity": "experimental",
  "capabilities": [
    "research.review_stage"
  ],
  "inputs": [],
  "outputs": [
    "research.review.v1"
  ],
  "adapter": {
    "type": "model",
    "provider": "configured-bridge",
    "model": "configured"
  },
  "risk": "R1",
  "permissions": {
    "filesystem": {
      "read": [
        "project:workspace"
      ],
      "write": [
        "attempt:workspace",
        "attempt:artifacts"
      ]
    },
    "network": {
      "mode": "disabled",
      "hosts": []
    },
    "process": true,
    "scheduler": false,
    "gpu": false,
    "externalWrite": false,
    "secretHandles": []
  },
  "tools": [],
  "evaluators": [
    "schema.valid",
    "research.integrity"
  ],
  "budgets": {
    "maxWallSeconds": 900,
    "maxToolCalls": 100,
    "maxSources": 50,
    "maxCostUsd": 0
  },
  "routing": {
    "allowImplicit": false
  }
}
